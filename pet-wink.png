<div id="ai-pet-container" style="position:fixed; bottom:10px; right:10px; z-index:9999; text-align:right;">
    
    <div id="pet-bubble" style="
        background: rgba(255, 255, 255, 0.95); 
        border: 2px solid #ffb7d5; 
        padding: 12px 18px; 
        border-radius: 20px 20px 0 20px; 
        margin-bottom: 15px; 
        font-size: 14px; 
        color: #ff69b4; 
        box-shadow: 0 5px 15px rgba(255, 105, 180, 0.2); 
        display: none; 
        white-space: normal; 
        max-width: 220px; 
        line-height: 1.5; 
        position: relative;
        font-weight: bold;
    ">
        喵？
        <div style="
            position: absolute; 
            bottom: -10px; 
            right: 20px; 
            width: 0; 
            height: 0; 
            border-style: solid; 
            border-width: 10px 10px 0 0; 
            border-color: #ffb7d5 transparent transparent transparent;
        "></div>
        <div style="
            position: absolute; 
            bottom: -7px; 
            right: 21px; 
            width: 0; 
            height: 0; 
            border-style: solid; 
            border-width: 9px 9px 0 0; 
            border-color: white transparent transparent transparent;
        "></div>
    </div>

    <div id="pet-character-shipper" style="cursor:pointer; position: relative;">
        <img id="pet-img-normal" src="image_0.png" alt="看板娘" style="height: 250px; width: auto; filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.15)); transition: transform 0.3s;">
        
        <img id="pet-img-wink" src="image_1.png" alt="看板娘眨眼" style="height: 250px; width: auto; filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.15)); display: none;">
        
        <img id="pet-img-chibi" src="image_2.png" alt="看板娘Q版" style="height: 180px; width: auto; filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.15)); display: none; margin-right: 20px;">
    </div>
</div>

<script>
    // 獲取 DOM 元素
    const petContainer = document.getElementById('ai-pet-container');
    const bubble = document.getElementById('pet-bubble');
    const shipper = document.getElementById('pet-character-shipper');
    
    // 圖片元素
    const imgNormal = document.getElementById('pet-img-normal');
    const imgWink = document.getElementById('pet-img-wink');
    const imgChibi = document.getElementById('pet-img-chibi');

    // 氣泡話庫 (普通狀態)
    const normalQuotes = [
        "這裡就是你的秘密基地嗎？(*ﾟ∀ﾟ*)",
        "今天也要加油喔！✨",
        "一直看著我，我會害羞的... ( >д<)",
        "你是怎麼發現這裡的喵？",
        "如果是你的話... 或許可以進去喔？"
    ];

    // 氣泡話庫 (解鎖狀態)
    const unlockedQuotes = [
        "哇！你進來了！好厲害喵！ฅ(•ㅅ•❀)ฅ",
        "這些寶物... 只能偷偷看喔！絕對不能告訴別人！",
        "哼，既然進來了，就陪我玩一會吧？",
        "你是認真的嗎？(//●⁰౪⁰●//)"
    ];

    let bubbleTimer; // 用於控制氣泡消失

    // 切換表情的函數
    function setExpression(type) {
        // 先隱藏所有圖片
        imgNormal.style.display = 'none';
        imgWink.style.display = 'none';
        imgChibi.style.display = 'none';

        // 根據類型顯示對應圖片
        if (type === 'wink') {
            imgWink.style.display = 'inline';
        } else if (type === 'chibi') {
            imgChibi.style.display = 'inline';
        } else {
            imgNormal.style.display = 'inline'; // 預設普通
        }
    }

    // 顯示氣泡和文字的函數
    function showBubble(text, duration = 4000) {
        bubble.innerText = text;
        bubble.style.display = 'block';
        
        // 清除舊的計時器，防止連續點擊導致提前消失
        clearTimeout(bubbleTimer);
        
        // 設定新的計時器
        bubbleTimer = setTimeout(() => { 
            bubble.style.display = 'none';
            setExpression('normal'); // 說完話恢復正常表情
        }, duration);
    }

    // --- 互動邏輯 ---

    // 1. 滑鼠移入：切換到眨眼/近照表情 (image_1.png)
    shipper.onmouseover = () => {
        setExpression('wink');
        imgWink.style.transform = 'scale(1.05)'; // 輕微放大
    };

    // 2. 滑鼠移出：恢復普通表情 (image_0.png)
    shipper.onmouseout = () => {
        setExpression('normal');
        imgWink.style.transform = 'scale(1)';
    };

    // 3. 點擊角色：說話並切換表情
    shipper.onclick = () => {
        // 檢查網頁是否已解鎖 (看 secret-content 是否顯示)
        const isUnlocked = document.getElementById('secret-content').style.display === 'block';
        
        if (isUnlocked) {
            // 已解鎖：顯示 Q 版 (image_2.png) 
            setExpression('chibi');
            const quote = unlockedQuotes[Math.floor(Math.random() * unlockedQuotes.length)];
            showBubble(quote);
        } else {
            // 未解鎖：隨機顯示 Wink 或 Normal
            const expType = Math.random() > 0.5 ? 'wink' : 'normal';
            setExpression(expType);
            const quote = normalQuotes[Math.floor(Math.random() * normalQuotes.length)];
            showBubble(quote);
        }
    };
</script>

