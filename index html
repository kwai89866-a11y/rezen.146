<!DOCTYPE html>
<html lang="zh-Hant" translate="no">
<head>
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <!-- 防止 Google 翻譯跳出 -->
    <meta name="google" content="notranslate">
    <title>喵！(っ●ω●)っ 這裡是私人領域喔！</title>
    <style>
        /* 基礎背景設定 */
        body {
            font-family: "Microsoft JhengHei", "PingFang TC", sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #ffeef8; 
            background-image: radial-gradient(#ffc1e3 1.5px, transparent 1.5px);
            background-size: 30px 30px;
            overflow: hidden;
        }

        /* 主容器樣式 */
        .container {
            background: white;
            padding: 2.5rem;
            border-radius: 30px;
            box-shadow: 0 15px 35px rgba(255, 105, 180, 0.25);
            text-align: center;
            max-width: 400px;
            width: 90%;
            border: 4px solid #ffb7d5;
            transition: transform 0.1s; /* 搖晃動畫基礎 */
            position: relative;
        }

        h2 { color: #ff69b4; margin-bottom: 10px; text-shadow: 1px 1px 0px #fff; }
        p { color: #888; font-size: 14px; line-height: 1.6; }
        label { display: block; margin-top: 15px; color: #ff85c0; font-weight: bold; font-size: 14px; }

        /* 輸入框：確保相容手寫，16px 防止 iOS 自動縮放 */
        input {
            width: 100%;
            padding: 12px;
            margin: 8px 0;
            border: 2px solid #ffd1e8;
            border-radius: 15px;
            background: #fffafa;
            box-sizing: border-box;
            outline: none;
            transition: all 0.3s ease;
            text-align: center;
            font-size: 16px; 
            -webkit-user-select: text !important;
            user-select: text !important;
        }
        input:focus { border-color: #ff69b4; box-shadow: 0 0 10px rgba(255,105,180,0.3); }

        /* 按鈕風格 */
        button {
            background: linear-gradient(45deg, #ff9a9e 0%, #ff69b4 100%);
            color: white;
            border: none;
            padding: 14px 20px;
            border-radius: 25px;
            cursor: pointer;
            width: 100%;
            font-size: 16px;
            font-weight: bold;
            margin-top: 20px;
            transition: 0.3s;
        }
        button:hover { transform: translateY(-3px) scale(1.02); }
        
        #secret-content { display: none; }

        /* 傳送門連結樣式 */
        .link-item {
            display: block;
            margin: 12px 0;
            padding: 14px;
            background: #fff0f5;
            text-decoration: none;
            color: #ff69b4;
            border-radius: 18px;
            transition: all 0.3s;
            border: 2px dashed #ffb7d5;
            font-weight: bold;
        }
        .link-item:hover { 
            background: #ff69b4; 
            color: white; 
            transform: rotate(-1.5deg) scale(1.03); 
            border-style: solid; 
        }

        .logout-btn { 
            background: #e0e0e0; 
            color: #666; 
            margin-top: 25px; 
            font-size: 14px; 
            border: none;
        }
    </style>
</head>
<body>

<div class="container" id="main-container">
    <!-- 驗證區域 -->
    <div id="auth-zone">
        <h2>(๑•̀ㅁ•́๑) 🛑 停止符！</h2>
        <p>「哼，居然敢隨便亂闖別人的秘密基地...<br>不、不過，如果是你的話，回答對問題就讓你進去喔！」</p>
        
        <label for="q1">✨ 我的降生日是哪一天呢？</label>
        <input type="password" id="q1" placeholder="一定要記得喔 (eg.0101)" inputmode="numeric" autocomplete="off">
        
        <label for="q2">😽 我最喜歡的運動是什麼呢？</label>
        <input type="text" id="q2" placeholder="答錯的話我會生氣喔！" autocomplete="off">
        
        <button onclick="val()">驗證身份 (//●⁰౪⁰●//)</button>
        <p id="error-msg" style="color: #ff4d4d; display: none; margin-top: 15px; font-weight: bold;">
            「笨、笨蛋！這才不是正確答案呢！再試一次啦 ( >д<)」
        </p>
    </div>

    <!-- 秘密內容區域 -->
    <div id="secret-content">
        <h2>(੭ु´ ᐜ `)੭ु⁾⁾ 歡迎回來！</h2>
        <p>「好啦，這些是你珍藏的寶物...」</p>
        
        <!-- 點擊後跳轉至 Google 搜尋頁面 -->
        <a href="https://www.google.com/search?q=https://hanime1.me/watch?v=403016" class="link-item" target="_blank">🌸 傳送門：私密數據 A</a>
        <a href="https://www.google.com/search?q=https://hanime1.me/watch?v=104062" class="link-item" target="_blank">🌸 傳送門：私密數據 B</a>
        <a href="https://www.google.com/search?q=https://hanime1.me/watch?v=110108" class="link-item" target="_blank">🌸 傳送門：私密數據 C</a>
        <a href="https://www.google.com/search?q=https://www.google.com" class="link-item" target="_blank">🔍 透過 Google 開啟 Google</a>
        
        <button onclick="location.reload()" class="logout-btn">快跑！有人來了 (登出/鎖定)</button>
    </div>
</div>

<script>
    function val() {
        // 獲取輸入值並去除空白
        const u1 = document.getElementById('q1').value.trim();
        const u2 = document.getElementById('q2').value.trim();
        
        const a1 = "0501";
        // 判定：同時支援繁體「籃球」與簡體「篮球」
        const isSportCorrect = (u2 === "籃球" || u2 === "篮球");

        if (u1 === a1 && isSportCorrect) {
            // 驗證成功
            document.getElementById('auth-zone').style.display = 'none';
            document.getElementById('secret-content').style.display = 'block';
        } else {
            // 驗證失敗：顯示訊息 + 搖晃動畫
            document.getElementById('error-msg').style.display = 'block';
            
            const container = document.getElementById('main-container');
            container.style.transform = 'translateX(10px)';
            setTimeout(() => container.style.transform = 'translateX(-10px)', 50);
            setTimeout(() => container.style.transform = 'translateX(10px)', 100);
            setTimeout(() => container.style.transform = 'translateX(0)', 150);
        }
    }

    // 支援實體鍵盤 Enter 送出
    document.addEventListener('keypress', function (e) {
        if (e.key === 'Enter') val();
    });
</script>

</body>
</html>

